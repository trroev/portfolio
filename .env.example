# Payload CMS
# A long, random string used to sign/encrypt tokens. Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# MongoDB Atlas connection string (Payload datastore)
# e.g. mongodb+srv://<user>:<password>@<cluster>.mongodb.net/portfolio?retryWrites=true&w=majority
DATABASE_URI=

# Vercel Blob read/write token (media uploads)
# Format: vercel_blob_rw_<store_id>_<random_string>
# Auto-provisioned when a Blob store is linked to the Vercel project; pull locally with `vercel env pull`.
BLOB_READ_WRITE_TOKEN=
