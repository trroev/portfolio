                      "~/blocks/**",
                      "~/fields/**",
                      "~/access/**"
                    ],
                    "message": "Features must not import from the cms layer. Fetch CMS data through the feature's api/ folder using the Payload local API."
                  },
                  {
                    "group": ["@payload-config"],
                    "message": "Get the Payload client from ~/lib/payload instead of importing payload.config directly."
                  },
                  {
                    "group": ["../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/marketing/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "!~/features/marketing",
                      "!~/features/marketing/**"
                    ],
                    "message": "Cross-feature imports are not allowed. Promote shared code to ~/components, ~/lib, or ~/config, and compose features at the app layer."
                  },
                  {
                    "group": ["~/app/**"],
                    "message": "Features must not import from the app layer (unidirectional flow: shared → features → app)."
                  },
                  {
                    "group": [
                      "~/collections/**",
                      "~/globals/**",
                      "~/blocks/**",
                      "~/fields/**",
                      "~/access/**"
                    ],
                    "message": "Features must not import from the cms layer. Fetch CMS data through the feature's api/ folder using the Payload local API."
                  },
                  {
                    "group": ["@payload-config"],
                    "message": "Get the Payload client from ~/lib/payload instead of importing payload.config directly."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/portfolio/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "!~/features/portfolio",
                      "!~/features/portfolio/**"
                    ],
                    "message": "Cross-feature imports are not allowed. Promote shared code to ~/components, ~/lib, or ~/config, and compose features at the app layer."
                  },
                  {
                    "group": ["~/app/**"],
                    "message": "Features must not import from the app layer (unidirectional flow: shared → features → app)."
                  },
                  {
                    "group": [
                      "~/collections/**",
                      "~/globals/**",
                      "~/blocks/**",
                      "~/fields/**",
                      "~/access/**"
                    ],
                    "message": "Features must not import from the cms layer. Fetch CMS data through the feature's api/ folder using the Payload local API."
                  },
                  {
                    "group": ["@payload-config"],
                    "message": "Get the Payload client from ~/lib/payload instead of importing payload.config directly."
                  },
                  {
                    "group": ["../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/portfolio/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "!~/features/portfolio",
                      "!~/features/portfolio/**"
                    ],
                    "message": "Cross-feature imports are not allowed. Promote shared code to ~/components, ~/lib, or ~/config, and compose features at the app layer."
                  },
                  {
                    "group": ["~/app/**"],
                    "message": "Features must not import from the app layer (unidirectional flow: shared → features → app)."
                  },
                  {
                    "group": [
                      "~/collections/**",
                      "~/globals/**",
                      "~/blocks/**",
                      "~/fields/**",
                      "~/access/**"
                    ],
                    "message": "Features must not import from the cms layer. Fetch CMS data through the feature's api/ folder using the Payload local API."
                  },
                  {
                    "group": ["@payload-config"],
                    "message": "Get the Payload client from ~/lib/payload instead of importing payload.config directly."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/components/**", "src/lib/**", "src/config/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "~/app/**",
                      "~/collections/**",
                      "~/globals/**",
                      "~/blocks/**",
                      "~/fields/**",
                      "~/access/**"
                    ],
                    "message": "Shared modules must not import from features, the app layer, or the cms layer (unidirectional flow: shared → features → app)."
                  },
                  {
                    "group": ["@payload-config"],
                    "message": "Only ~/lib/payload may import payload.config — it is the single sanctioned cms touchpoint for the shared layer."
                  },
                  {
                    "group": ["../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/lib/payload.ts"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "~/app/**",
                      "~/collections/**",
                      "~/globals/**",
                      "~/blocks/**",
                      "~/fields/**",
                      "~/access/**"
                    ],
                    "message": "Shared modules must not import from features, the app layer, or the cms layer (unidirectional flow: shared → features → app)."
                  },
                  {
                    "group": ["../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": [
        "src/collections/**",
        "src/globals/**",
        "src/blocks/**",
        "src/fields/**",
        "src/access/**",
        "src/payload.config.ts"
      ],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "~/app/**",
                      "~/components/**",
                      "~/config/**"
                    ],
                    "message": "The cms layer (collections, globals, fields, access, payload.config) may import only from ~/lib. See docs/adr/0002-architecture-import-boundaries.md."
                  },
                  {
                    "group": ["../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    }
  ]
}
