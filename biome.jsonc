{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/astro",
  ],
  "files": {
    "includes": [
      "!.claude",
      "!.astro",
      "!.vercel",
      "!dist",
      "!next.config.ts",
      "!next-env.d.ts",
      "!src/access",
      "!src/app",
      "!src/blocks",
      "!src/collections",
      "!src/features",
      "!src/fields",
      "!src/globals",
      "!src/plugins",
      "!src/payload.config.ts",
      "!src/payload-types.ts",
      "!src/components/button-link.tsx",
      "!src/components/cta-band.tsx",
      "!src/components/cta-button.tsx",
      "!src/components/page-intro.tsx",
      "!src/components/rich-text.tsx",
      "!src/components/site-footer.tsx",
      "!src/components/site-header.tsx",
      "!src/components/theme-provider.tsx",
      "!src/components/theme-toggle.tsx",
      "!src/components/wordmark.tsx",
      "!src/lib/metadata.ts",
      "!src/lib/page-href.ts",
      "!src/lib/page-seo.ts",
      "!src/lib/payload.ts",
      "!src/lib/resolve-media.ts",
      "!src/lib/revalidate.ts",
    ],
  },
  "formatter": {
    "enabled": false,
  },
  "javascript": {
    "formatter": {
      "enabled": false,
    },
  },
  "json": {
    "formatter": {
      "enabled": false,
    },
  },
  "css": {
    "formatter": {
      "enabled": false,
    },
  },
  "html": {
    "formatter": {
      "enabled": false,
    },
  },
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": "off",
      },
      "performance": {
        "noJsxPropsBind": "off",
      },
      "style": {
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "generic" },
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" },
        },
      },
    },
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "off",
          },
          "suspicious": {
            "noLeakedRender": "off",
            "noUnknownAttribute": "off",
          },
        },
      },
    },
  ],
}
