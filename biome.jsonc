{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/next"
  ],
  "files": {
    "includes": [
      "!src/payload-types.ts",
      "!**/importMap.js",
      "!src/app/(payload)",
      "!.claude"
    ]
  },
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      },
      "style": {
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "generic" }
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" }
        }
      }
    }
  },
  // Architecture boundaries (unidirectional flow: shared → features → app;
  // cms layer → lib only). See docs/adr/0002-architecture-import-boundaries.md.
  "overrides": [
    {
      "includes": ["src/features/contact/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "!~/features/contact",
                      "!~/features/contact/**"
                    ],
                    "message": "Cross-feature imports are not allowed. Promote shared code to ~/components, ~/lib, or ~/config, and compose features at the app layer."
                  },
                  {
                    "group": ["~/app/**"],
                    "message": "Features must not import from the app layer (unidirectional flow: shared → features → app)."
                  },
                  {
                    "group": [
                      "~/collections/**",
                      "~/globals/**",
                      "~/blocks/**",
                      "~/fields/**",
                      "~/access/**"
                    ],
                    "message": "Features must not import from the cms layer. Fetch CMS data through the feature's api/ folder using the Payload local API."
                  },
                  {
                    "group": ["@payload-config"],
                    "message": "Get the Payload client from ~/lib/payload instead of importing payload.config directly."
                  },
                  {
                    "group": ["../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/contact/*/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "!~/features/contact",
                      "!~/features/contact/**"
                    ],
                    "message": "Cross-feature imports are not allowed. Promote shared code to ~/components, ~/lib, or ~/config, and compose features at the app layer."
                  },
                  {
                    "group": ["~/app/**"],
                    "message": "Features must not import from the app layer (unidirectional flow: shared → features → app)."
                  },
                  {
                    "group": [
                      "~/collections/**",
                      "~/globals/**",
                      "~/blocks/**",
                      "~/fields/**",
                      "~/access/**"
                    ],
                    "message": "Features must not import from the cms layer. Fetch CMS data through the feature's api/ folder using the Payload local API."
                  },
                  {
                    "group": ["@payload-config"],
                    "message": "Get the Payload client from ~/lib/payload instead of importing payload.config directly."
                  },
                  {
                    "group": ["../../**"],
                    "message": "Relative imports must not cross a layer or feature boundary — use the ~/* alias so the boundary rules apply."
                  }
                ]
              }
            }
          }
        }
      }
    },
    {
      "includes": ["src/features/marketing/*"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "patterns": [
                  {
                    "group": [
                      "~/features/*",
                      "~/features/**",
                      "!~/features/marketing",
                      "!~/features/marketing/**"
                    ],
                    "message": "Cross-feature imports are not allowed. Promote shared code to ~/components, ~/lib, or ~/config, and compose features at the app layer."
                  },
                  {
                    "group": ["~/app/**"],
                    "message": "Features must not import from the app layer (unidirectional flow: shared → features → app)."
                  },
                  {
                    "group": [
                      "~/collections/**",
