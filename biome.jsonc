{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "extends": [
    "ultracite/biome/core",
    "ultracite/biome/react",
    "ultracite/biome/astro",
  ],
  "files": {
    "includes": ["!.claude", "!.astro", "!.vercel", "!dist"],
  },
  "formatter": {
    "enabled": false,
  },
  "javascript": {
    "formatter": {
      "enabled": false,
    },
  },
  "json": {
    "formatter": {
      "enabled": false,
    },
  },
  "css": {
    "formatter": {
      "enabled": false,
    },
  },
  "html": {
    "formatter": {
      "enabled": false,
    },
  },
  "linter": {
    "rules": {
      "nursery": {
        "useSortedClasses": "off",
      },
      "performance": {
        "noJsxPropsBind": "off",
      },
      "style": {
        "useConsistentArrayType": {
          "level": "error",
          "options": { "syntax": "generic" },
        },
        "useConsistentTypeDefinitions": {
          "level": "error",
          "options": { "style": "type" },
        },
      },
    },
  },
  "overrides": [
    {
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "useJsxKeyInIterable": "off",
          },
          "suspicious": {
            "noLeakedRender": "off",
            "noUnknownAttribute": "off",
          },
        },
      },
    },
  ],
}
