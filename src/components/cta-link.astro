---
import { RiDownload2Line } from "@remixicon/react";
import { type ButtonStyleProps, buttonStyles } from "~/components/button";
import { cn } from "~/lib/cn";
import { type Cta, ctaHref } from "~/lib/cta";

type Props = ButtonStyleProps & {
  cta: Cta;
  class?: string;
};

const { cta, variant, class: className } = Astro.props;
const isDownload = cta.kind === "download";
---

<a
  class={buttonStyles({
    className: cn(isDownload && "gap-2", className),
    variant,
  })}
  download={isDownload}
  href={ctaHref(cta)}
>
  {cta.label}
  {isDownload && <RiDownload2Line aria-hidden="true" size={18} />}
</a>
