---
import CtaLink from "~/components/cta-link.astro";
import Prose from "~/components/prose.astro";
import type { Lockup } from "~/lib/lockup";

type Props = Lockup;

const { eyebrow, heading, subheading, ctas = [] } = Astro.props;
---

<div>
  <header class="flex flex-col gap-4">
    {eyebrow && (
      <p class="text-sm font-medium tracking-[0.2em] text-accent uppercase">
        {eyebrow}
      </p>
    )}
    <h1 class="font-display text-4xl font-semibold text-balance sm:text-5xl">
      {heading}
    </h1>
    {subheading && (
      <p class="max-w-2xl text-lg text-balance text-text-muted">{subheading}</p>
    )}
    {ctas.length > 0 && (
      <div class="mt-2 flex flex-wrap items-center gap-3">
        {ctas.map((cta) => (
          <CtaLink cta={cta} />
        ))}
      </div>
    )}
  </header>
  {Astro.slots.has("default") && (
    <Prose class="mt-6 max-w-2xl">
      <slot />
    </Prose>
  )}
</div>
