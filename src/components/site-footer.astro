---
import {
  type RemixiconComponentType,
  RiGithubFill,
  RiLinkedinBoxFill,
} from "@remixicon/react";
import { buttonStyles } from "~/components/button";
import Wordmark from "~/components/wordmark.astro";
import { pageHref } from "~/config/pages";
import { siteConfig } from "~/config/site";
import { type SocialPlatform, siteChrome } from "~/config/site-chrome";

type SocialPlatformDisplay = {
  icon: RemixiconComponentType;
  label: string;
};

const socialPlatforms: Record<SocialPlatform, SocialPlatformDisplay> = {
  github: { icon: RiGithubFill, label: "GitHub" },
  linkedin: { icon: RiLinkedinBoxFill, label: "LinkedIn" },
};

const { footerItems, socialLinks } = siteChrome;
const year = new Date().getFullYear();
---

<footer class="border-t border-border">
  <div class="mx-auto flex w-full max-w-5xl flex-col gap-8 px-6 py-10 sm:flex-row sm:items-start sm:justify-between">
    <div class="flex flex-col items-start gap-2">
      <Wordmark />
      <p class="max-w-xs text-sm text-text-muted">
        Full-stack developer building clean, professional web experiences.
      </p>
      {footerItems.length > 0 && (
        <nav aria-label="Footer" class="mt-2">
          <ul class="flex flex-wrap gap-x-4 gap-y-1">
            {footerItems.map((item) => (
              <li>
                <a
                  class="focus-ring rounded-sm text-sm font-medium text-accent hover:underline"
                  href={pageHref(item.page)}
                >
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </div>

    <div class="flex flex-col gap-3 sm:items-end">
      {socialLinks.length > 0 && (
        <div class="flex items-center gap-1">
          {socialLinks.map((social) => {
            const { icon: Icon, label } = socialPlatforms[social.platform];
            return (
              <a
                aria-label={`Trevor Mathiak on ${label}`}
                class={buttonStyles({ variant: "icon" })}
                href={social.url}
                rel="noopener noreferrer"
                target="_blank"
              >
                <Icon aria-hidden="true" size={20} />
              </a>
            );
          })}
        </div>
      )}
      <p class="text-xs text-text-muted">
        © {year} {siteConfig.author}
      </p>
    </div>
  </div>
</footer>
