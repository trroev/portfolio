---
import BlockStack from "~/components/block-stack.astro";
import ContactForm from "~/components/blocks/contact-form.astro";
import PageIntro from "~/components/blocks/page-intro.astro";
import BaseLayout from "~/layouts/base-layout.astro";

const subheading =
  "Have a project in mind, or just want to say hello? Send me a message and I'll get back to you.";
---

<BaseLayout description={subheading} title="Contact">
  <BlockStack>
    <PageIntro
      eyebrow="Contact"
      heading="Get in touch"
      subheading={subheading}
    />
    <ContactForm />
  </BlockStack>
</BaseLayout>
